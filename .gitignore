# ---- Dependencies ----
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Expo ----
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ---- Native build output ----
# Ignored because this project uses Expo CNG (Continuous Native Generation):
# the ios/ and android/ directories are regenerated by `expo prebuild`.
# If the project ever ejects to the bare workflow, un-ignore these.
/ios/
/android/
*.ipa
*.apk
*.aab
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ---- Release signing ----
# The upload keystore and its password file. `*.p12` above already covers the
# keystore by extension; these rules cover the directory and the password file,
# which no extension rule catches. Nothing in here may ever be committed:
# the passwords are in it, and `credentials.json` below is EAS's own unrelated
# file, not this.
/credentials/
keystore.properties
*.keystore

# ---- EAS ----
.easignore
credentials.json

# ---- Environment & secrets ----
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist

# ---- Supabase ----
supabase/.branches/
supabase/.temp/
supabase/.env

# ---- Build & cache ----
*.tsbuildinfo
.cache/
.turbo/
coverage/
.eslintcache
metro-health-check*

# ---- Generated / local data ----
# The card seed snapshot is generated from the Riftcodex API at build time.
assets/seed/*.json
!assets/seed/.gitkeep
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- Logs ----
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# ---- Editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS / OneDrive ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
